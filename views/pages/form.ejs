<section class="form-section">
    <a href="/" class="back-link">← Kembali</a>

    <div class="form-card">
        <p class="eyebrow">CAFEMENU MANAGEMENT</p>
        <h1><%= menu ? 'Edit Menu' : 'Tambah Menu Baru' %></h1>
        <p class="form-description">
            Lengkapi informasi makanan atau minuman.
        </p>

        <form action="<%= action %>" method="POST">

            <label for="nama_menu">Nama Menu</label>
            <input
                type="text"
                id="nama_menu"
                name="nama_menu"
                value="<%= menu ? menu.nama_menu : '' %>"
                placeholder="Contoh: Caramel Latte"
                maxlength="100"
                required
            >

            <label for="kategori">Kategori</label>
            <select id="kategori" name="kategori" required>
                <option value="">Pilih kategori</option>
                <% ['Kopi', 'Non-Kopi', 'Makanan'].forEach(item => { %>
                    <option value="<%= item %>"
                        <%= menu && menu.kategori === item ? 'selected' : '' %>>
                        <%= item %>
                    </option>
                <% }) %>
            </select>

            <label for="harga">Harga (Rp)</label>
            <input
                type="number"
                id="harga"
                name="harga"
                value="<%= menu ? menu.harga : '' %>"
                placeholder="Contoh: 25000"
                min="1"
                step="1"
                required
            >

            <label for="deskripsi">Deskripsi</label>
            <textarea
                id="deskripsi"
                name="deskripsi"
                rows="4"
                placeholder="Deskripsikan menu..."
            ><%= menu ? menu.deskripsi : '' %></textarea>

            <label for="foto">Nama File Foto</label>
            <input
                type="text"
                id="foto"
                name="foto"
                value="<%= menu ? menu.foto : '' %>"
                placeholder="Contoh: caramel-latte.jpg"
            >

            <button type="submit" class="primary-btn form-submit">
                <%= menu ? 'Simpan Perubahan' : 'Tambah Menu' %>
            </button>
        </form>
    </div>
</section>
